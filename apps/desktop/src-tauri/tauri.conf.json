{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoFile",
  "version": "1.0.0",
  "identifier": "app.neofile.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://127.0.0.1:47321",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeoFile",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' blob: data: asset: http://asset.localhost; media-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
